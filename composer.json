{
    "name": "zhangjinteng/6mm-prediction",
    "description": "Framework-agnostic PHP client and generated gRPC contracts for 6MM prediction services.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-grpc": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "google/protobuf": "^4.33.6",
        "grpc/grpc": "^1.57"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "SixMm\\Prediction\\": "src/",
            "Prediction\\": "generated/Prediction/",
            "GPBMetadata\\Prediction\\": "generated/GPBMetadata/Prediction/",
            "Google\\Rpc\\": "generated/Google/Rpc/",
            "GPBMetadata\\Google\\Rpc\\": "generated/GPBMetadata/Google/Rpc/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SixMm\\Prediction\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "scripts": {
        "generate": "bash scripts/generate-protos.sh",
        "test": "phpunit --do-not-cache-result",
        "check": ["@composer validate --strict", "@test"]
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [{
        "name": "packagist.org",
        "type": "composer",
        "url": "https://repo.packagist.org"
    }]
}
